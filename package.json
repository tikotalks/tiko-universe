{
  "name": "tiko-universe",
  "private": true,
  "version": "0.0.0",
  "description": "API-first Tiko platform with web, iOS, and Android clients.",
  "type": "module",
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*/web",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "check": "npm run scaffold:check && npm run generated:check && npm run glyphs:check && npm run geography:check && npm run arlez:check && npm run lint && npm run typecheck && npm run test",
    "glyphs:check": "node tools/check-glyph-packs.mjs",
    "geography:check": "node tools/geography/check-content-sources.mjs && node tools/geography/build-geography.mjs --check && node tools/geography/build-water.mjs --check && node tools/geography/build-places.mjs --check && node tools/geography/build-cities.mjs --check && node tools/geography/build-subdivisions.mjs --check && node tools/geography/build-bathymetry.mjs --check && node tools/geography/check-placements.mjs && node tools/geography/check-coverage.mjs",
    "geography:gaps": "node tools/geography/report-media-gaps.mjs && node tools/geography/check-coverage.mjs --write",
    "geography:content": "node tools/geography/build-animals.mjs --write && node tools/geography/build-landmarks.mjs --write && node tools/geography/report-media-gaps.mjs",
    "geography:build": "npm --prefix tools/geography install --no-audit --no-fund && node tools/geography/build-geography.mjs && node tools/geography/build-water.mjs && node tools/geography/build-places.mjs && node tools/geography/build-cities.mjs && node tools/geography/build-subdivisions.mjs && node tools/geography/build-people.mjs --write && node tools/geography/build-bathymetry.mjs",
    "generate:app-configs": "node tools/generate-app-configs.mjs",
    "generate:colors": "node tools/generate-tiko-colors.mjs",
    "generate:talk-seeds": "node tools/generate-talk-seeds.mjs",
    "generate:write-seeds": "node tools/generate-write-seeds.mjs",
    "prebuild": "npm run generate:colors",
    "scaffold:check": "node tools/check-placeholders.mjs",
    "lint": "oxlint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "vitest run tests/identity-api.test.ts tests/app-api.test.ts tests/generation-api.test.ts tests/atlas-api.test.ts tests/testing-contract.test.ts",
    "test:services": "npm run test:contracts",
    "build": "npm run build --workspaces --if-present",
    "audit:data-isolation": "node tools/check-d1-isolation.mjs",
    "android:list": "node tools/android-wrappers.mjs list",
    "android:sync": "node tools/android-wrappers.mjs sync",
    "android:build": "node tools/android-wrappers.mjs build-android",
    "audit:doctrine": "node tools/check-doctrine.mjs",
    "deploy:dry-run:tts": "npm --workspace @tiko-worker/tts-api run deploy:dry-run",
    "deploy:dry-run:generation": "npm --workspace @tiko-worker/generation-api run deploy:dry-run",
    "deploy:dry-run:sentence": "npm --workspace @tiko-worker/sentence-api run deploy:dry-run",
    "ios:bump": "node tools/bump-ios-version.mjs",
    "release:preflight": "npx --yes --package @sil/app-release app-release-all --mode preflight",
    "release:validate": "npx --yes --package @sil/app-release app-release-all --mode validate",
    "release:screenshots": "npx --yes --package @sil/app-release app-release-all --mode screenshots --output-root /Users/silvandiepen/Projects/Tiko/apps",
    "release:promo-videos": "npx --yes --package @sil/app-release app-release-all --mode promo-video --output-root /Users/silvandiepen/Projects/Tiko/apps",
    "release:archive": "npx --yes --package @sil/app-release app-release-all --mode archive",
    "release:upload-build": "npx --yes --package @sil/app-release app-release-all --mode upload-build",
    "release:prepare-metadata": "npx --yes --package @sil/app-release app-release-all --mode prepare-metadata",
    "release:upload-metadata": "npx --yes --package @sil/app-release app-release-all --mode upload-metadata",
    "release:prepare-screenshots": "npx --yes --package @sil/app-release app-release-all --mode prepare-screenshots",
    "release:upload-screenshots": "npx --yes --package @sil/app-release app-release-all --mode upload-screenshots",
    "release:distribute": "npx --yes --package @sil/app-release app-release-all --mode distribute",
    "release:all": "npx --yes --package @sil/app-release app-release-all --mode all --output-root /Users/silvandiepen/Projects/Tiko/apps",
    "generate:locales": "node tools/generate-locales.mjs",
    "generate:ui-translations": "node tools/generate-ui-translations.mjs",
    "i18n:report": "node tools/generate-ui-translations.mjs --report",
    "generated:check": "node tools/generate-locales.mjs --check && node tools/generate-ui-translations.mjs --check && node tools/generate-talk-packs.mjs --check && node tools/generate-talk-packs-index.mjs --check && node tools/generate-talk-realizer-bundle.mjs --check && node tools/generate-talk-seeds.mjs --check && node tools/generate-write-seeds.mjs --check",
    "generate:talk-packs": "node tools/generate-talk-packs.mjs",
    "generate:talk-packs-index": "node tools/generate-talk-packs-index.mjs",
    "generate:talk-bundle": "node tools/generate-talk-realizer-bundle.mjs",
    "arlez:check": "node tools/generate-arlez-projects.mjs --check",
    "arlez:refresh": "node tools/generate-arlez-projects.mjs --refresh"
  },
  "dependencies": {
    "@sil/ui": "^2.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "bemm": "^1.4.0",
    "jsdom": "^27.2.0",
    "open-icon": "^1.1.9",
    "sass": "^1.94.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14",
    "vue": "^3.5.24",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.1.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "miniflare": "^4.20260611.0",
    "oxlint": "^1.69.0",
    "sharp": "^0.34.5",
    "wrangler": "^4.98.0"
  }
}
