# Copy to .env and fill in. .env is gitignored; never commit the real values.

# Tiko service key or a signed-in Tiko token. Needed only by the tools that ask
# the generation worker to draw something — tools/geography/generate-people-art.mjs.
# Reading from the media library needs no key at all.
TIKO_API_KEY=

# Optional: point the tools at a different generation worker.
# TIKO_GENERATION_API=https://generation.tikoapi.org/v1/generation
