/build/

# Xcode / SwiftPM build + per-user state
DerivedData/
**/xcuserdata/
*.xcuserstate
.build/
**/.build/
.swiftpm/
# Library package resolved file (apps keep their xcshareddata Package.resolved)
packages/tikokit-ios/Package.resolved

apps/ios/**/*.xcodeproj/
apps/android/**/.gradle/
apps/android/**/build/

# Kotlin / Gradle (root build for :stroke-core and :tikokotlinkit).
# The TikoCore XCFramework is built, never committed.
.gradle/
**/.gradle/
/build/
engines/*/build/
packages/tikokotlinkit/build/
local.properties
.kotlin/
**/.kotlin/

# iOS release artifacts (screenshots, archives, videos, generated metadata)
artifacts/

# iOS build output (archives, .ipa, dSYMs)
apps/*/ios/build/

# Git worktrees for parallel agent sessions — never part of the repo itself.
.claude/worktrees/

# XcodeGen output for Write (generated from Project.yml)
apps/write/ios/TikoWrite.xcodeproj/
