{
  "app": "sum",
  "name": "Sum",
  "scheme": "TikoSum",
  "project": "apps/sum/ios/TikoSum.xcodeproj",
  "iosDir": "apps/sum/ios",
  "bundleId": "mt.tiko.sum",
  "appleId": "6794587838",
  "appStoreId": "6794587838",
  "appStoreUrl": "https://apps.apple.com/app/id6794587838",
  "validation": {
    "script": "apps/sum/ios/scripts/validate-local.sh"
  },
  "screenshots": {
    "outputDir": "/Users/silvandiepen/Projects/Tiko/apps/sum",
    "configuration": "Debug",
    "eraseBeforeCapture": false,
    "defaultWaitSeconds": 8,
    "baseLaunchArgs": [
      "--screenshot-mode"
    ],
    "statusBar": {
      "time": "9:41",
      "wifiBars": 3,
      "cellularBars": 4,
      "batteryState": "charged",
      "batteryLevel": 100
    },
    "devices": [
      {
        "name": "iPhone 17 Pro Max",
        "os": "26.2",
        "displayType": "APP_IPHONE_67",
        "createIfMissing": true
      },
      {
        "name": "iPad Pro 13-inch (M5)",
        "os": "26.2",
        "displayType": "APP_IPAD_PRO_13",
        "createIfMissing": true
      }
    ],
    "locales": [
      {
        "id": "en-US",
        "appLanguage": "en"
      }
    ],
    "colorModes": [
      {
        "id": "light",
        "userDefaults": {
          "tiko.colorMode": "light"
        }
      },
      {
        "id": "dark",
        "userDefaults": {
          "tiko.colorMode": "dark"
        }
      }
    ],
    "scenarios": [
      {
        "id": "home-light",
        "filename": "01-{deviceSlug}-home-en-light.png",
        "launchArgs": [
          "--screenshot",
          "home"
        ],
        "locales": [
          {
            "id": "en-US",
            "appLanguage": "en"
          }
        ],
        "colorModes": [
          "light"
        ],
        "waitSeconds": 8
      },
      {
        "id": "home-dark",
        "filename": "02-{deviceSlug}-home-en-dark.png",
        "launchArgs": [
          "--screenshot",
          "home"
        ],
        "locales": [
          {
            "id": "en-US",
            "appLanguage": "en"
          }
        ],
        "colorModes": [
          "dark"
        ],
        "waitSeconds": 8
      },
      {
        "id": "practice-light",
        "filename": "03-{deviceSlug}-practice-en-light.png",
        "launchArgs": [
          "--screenshot",
          "practice"
        ],
        "locales": [
          {
            "id": "en-US",
            "appLanguage": "en"
          }
        ],
        "colorModes": [
          "light"
        ],
        "waitSeconds": 8
      },
      {
        "id": "practice-dark",
        "filename": "04-{deviceSlug}-practice-en-dark.png",
        "launchArgs": [
          "--screenshot",
          "practice"
        ],
        "locales": [
          {
            "id": "en-US",
            "appLanguage": "en"
          }
        ],
        "colorModes": [
          "dark"
        ],
        "waitSeconds": 8
      },
      {
        "id": "keypad-light",
        "filename": "05-{deviceSlug}-keypad-en-light.png",
        "launchArgs": [
          "--screenshot",
          "keypad"
        ],
        "locales": [
          {
            "id": "en-US",
            "appLanguage": "en"
          }
        ],
        "colorModes": [
          "light"
        ],
        "waitSeconds": 8
      },
      {
        "id": "keypad-dark",
        "filename": "06-{deviceSlug}-keypad-en-dark.png",
        "launchArgs": [
          "--screenshot",
          "keypad"
        ],
        "locales": [
          {
            "id": "en-US",
            "appLanguage": "en"
          }
        ],
        "colorModes": [
          "dark"
        ],
        "waitSeconds": 8
      }
    ]
  },
  "archive": {
    "configuration": "Release",
    "archivePath": "artifacts/archives/sum/TikoSum.xcarchive",
    "exportPath": "artifacts/archives/sum/export",
    "exportOptionsPlist": "release/ExportOptions.plist",
    "allowProvisioningUpdates": true
  },
  "upload": {
    "ipaPath": "artifacts/archives/sum/export/TikoSum.ipa",
    "deliverDir": "artifacts/app-store/sum",
    "apiKeyEnv": "APP_STORE_CONNECT_KEY_ID",
    "apiIssuerEnv": "APP_STORE_CONNECT_ISSUER_ID"
  }
}
